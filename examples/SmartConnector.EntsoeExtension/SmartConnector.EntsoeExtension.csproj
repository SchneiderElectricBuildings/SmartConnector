<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SmartConnector.EntsoeExtension</RootNamespace>
    <AssemblyName>SmartConnector.EntsoeExtension</AssemblyName>
    <AssemblyTitle>SmartConnector ENTSO-E Extension</AssemblyTitle>
    <Description>Smart Connector extension that integrates with the ENTSO-E Transparency Platform to provide day-ahead electricity prices, load data, generation forecasts, and load-shifting signals to EWS clients.</Description>
    <Company>Schneider Electric</Company>
    <Product>EcoStruxure Smart Connector</Product>
    <Copyright>Copyright © Schneider Electric 2026</Copyright>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mongoose.Process" Version="2.6.*" />
    <PackageReference Include="Mongoose.Ews.Server.Data" Version="2.6.*" />
    <PackageReference Include="SxL.Common" Version="2.6.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
</Project>
